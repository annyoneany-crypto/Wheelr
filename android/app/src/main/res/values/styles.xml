<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The web UI is dark-only, so the native window has to be dark too:
         on the stock (light) parent theme the status bar stayed white while the
         plugin painted its icons light, leaving white-on-white system text. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/brandSurface</item>
        <item name="android:statusBarColor">@color/brandSurface</item>
        <item name="android:navigationBarColor">@color/brandSurface</item>
        <!-- Dark bars want light icons. -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Without this the activity keeps the light Theme.SplashScreen after the
             splash is dismissed, which is what turned the status bar white. -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>

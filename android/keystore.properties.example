# Copy to `keystore.properties` (same folder) and fill in with your own values.
# That file is gitignored — never commit it, and never commit the .jks itself.
#
# IMPORTANT: this is a .properties file, so a backslash is an escape character.
# Always write the path with FORWARD slashes, even on Windows, or Gradle will
# fail with "the syntax of the file name is incorrect".

storeFile=C:/Users/<you>/keystores/wheelr-upload.jks
storePassword=<the store password you chose>
keyAlias=wheelr-upload
keyPassword=<the key password you chose>
